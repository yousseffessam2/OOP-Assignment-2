#include <iostream>
using namespace std;
int main() {
int a, b, c;
cout << "Enter three sides: ";
cin >> a >> b >> c;
if (a <= 0 || b <= 0 || c <= 0 ||
a >= b + c || b >= a + c || c >= a + b) {
cout << "Not a valid triangle";
} else {
if (a == b) {
if (b == c)
cout << "Equilateral";
else
cout << "Isosceles";
} else {
if (a == c || b == c)
cout << "Isosceles";
else
cout << "Scalene";
}
}
return 0;
}
